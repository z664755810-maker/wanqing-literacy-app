# ---------------------------------------------------------------------------
# 晚晴识字 · 项目自定义忽略（v1.17 收尾时补充）
# ---------------------------------------------------------------------------

# 🔴 签名密钥：绝不可上传。泄露会导致他人冒名发布同名 App。
android/key.properties
android/keystore/
*.jks
*.keystore

# 构建产物（本地可重建，不进仓库）
/android/build/
android/.gradle/
android/.kotlin/
*.apk
*.aab
*.apk.sha1

# Gradle 项目级缓存（1.9GB；注意保留 android/gradle/wrapper/ 以便构建）
android/gradle/caches/

# 交付目录（APK 改走 GitHub Release）
/dist/

# 本机脚本产生的临时/诊断产物
# （Release API 请求/响应含私密 upload_url，不进仓库；注释必须单独成行，Git 不支持行内 #）
tool/_voice_id_map.txt
tool/_rel_req.json
tool/_rel_resp.json
tool/_rel_patch.json
tool/_rel_patch_resp.json
tool/_upload_resp.json
tool/_upload_url.txt
tool/__pycache__/
tool/apksigner_out.txt
# 声调诊断样本，可由 diag_tone.py 重建
tool/diag_*.mp3
tool/verify_*.mp3
tool/pinyin_*.mp3
tool/hanzi_*.mp3

# Flutter 生成的 .android 目录（含本机插件 junction，不可移植）
.android/
.macos/
.windows/
.linux/

# 试听核对目录：内容是从 assets/audio 复制的副本，可由脚本重建，不进仓库
tool/试听_声调核对/
